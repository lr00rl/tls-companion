    "data": "node scripts/data.mjs && node scripts/build-notes.mjs && node scripts/build-rfc.mjs",
    "data:notes": "node scripts/build-notes.mjs",
    "data:rfc": "node scripts/build-rfc.mjs",
    "sync:notes": "node scripts/sync-notes.mjs",
